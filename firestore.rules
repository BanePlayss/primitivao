// Firestore Security Rules — Primitivão
// =====================================
//
// Estado atual: o app não usa Firebase Auth (login é nick+senha custom no
// client + hash SHA-256 guardado no doc). Por isso, as rules abaixo são
// "defensivas estruturais" — não conseguem identificar usuário, mas impedem:
//   1. Escritas em qualquer outro lugar do projeto Firebase
//   2. Apagar QUALQUER um dos dois docs (delete: if false)
//   3. Substituir o payload por algo que não tem a forma esperada
//   4. Spam de payloads gigantes (>1MB)
//   5. Zerar de uma vez users/bets/teamPlayers (vandalismo) — o JSON novo
//      não pode encolher <40% do anterior
//   6. Zerar/encolher bruscamente a classificação (mesmo guard no doc state)
//
// PRÓXIMO PASSO (recomendado): habilitar Firebase Auth Anonymous, fazer
// `signInAnonymously()` no boot do app, e mudar `allow write` pra exigir
// `request.auth != null`. Isso bloqueia 100% de escrita de fora do app.
//
// COMO APLICAR: cola este arquivo em
// console.firebase.google.com → Firestore Database → Rules → Publish.
// Ou usa firebase CLI: `firebase deploy --only firestore:rules`.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Doc principal do app: leitura pública (necessária pro app funcionar),
    // escrita só passa se for estruturalmente válida.
    match /primitivao/apostas {

      allow read: if true;

      // Update permitido se:
      //  - O campo `json` ainda existir e for string (não apagaram)
      //  - O payload total cabe em 1MB (limite generoso, real é ~50KB)
      //  - NÃO está zerando users/teamPlayers/comments quando antes tinha
      //    coisas — protege contra "rm -rf" via console do browser
      allow update: if isValidApostasDoc(request.resource.data)
        && notWipingJson(request.resource.data, resource.data);

      // Criação só é permitida se o doc não existia (caso inicial)
      allow create: if isValidApostasDoc(request.resource.data);

      // NUNCA apagar — backup deve existir antes
      allow delete: if false;
    }

    // Doc de classificação: leitura pública, escrita estrutural.
    match /primitivao/state {
      allow read: if true;
      allow update: if request.resource.data.keys().hasAny(['rounds', 'json'])
        && payloadFits(request.resource.data)
        // Mesma proteção anti-"rm -rf" do doc de apostas: bloqueia uma
        // escrita que encolha bruscamente os placares (>60%). Um reset de
        // temporada legítimo mantém a estrutura (7 rodadas) e passa; um wipe
        // pra rounds vazio é rejeitado. Fecha o gap de a classificação poder
        // ser zerada via console do browser.
        && notWipingJson(request.resource.data, resource.data);
      allow create: if true;
      allow delete: if false;
    }

    // Avatares custom (fotos dos jogadores) — doc SEPARADO { nickLower: dataUrl }.
    // Fica fora do doc de apostas pra não inchá-lo. Mesma postura defensiva dos
    // outros docs (app ainda não usa Auth): leitura pública, escrita estrutural.
    // O cliente comprime cada foto (~20KB) antes de gravar; o Firestore já barra
    // doc > 1MB sozinho. Aqui só limitamos o nº de chaves (nicks) como safety net.
    match /primitivao/avatars {
      allow read: if true;
      allow create, update: if request.resource.data.size() <= 100;
      allow delete: if false;
    }

    // Campeonatos lançados pelo admin (M8) — doc SEPARADO { json: "{champs:{...}}" }.
    // Mesma postura defensiva: leitura pública, escrita estrutural, nunca apaga.
    match /primitivao/championships {
      allow read: if true;
      allow create: if request.resource.data.json is string && payloadFits(request.resource.data);
      allow update: if request.resource.data.json is string && payloadFits(request.resource.data);
      allow delete: if false;
    }

    // PRIMICORD (app nativo de voz) — coleção pc_rooms.
    // Aqui NÃO passa mídia: a voz vai P2P direto entre os PCs. O Firestore só serve
    // de "ponto de encontro" — que salas existem, quem está em cada uma, e o IP:porta
    // público de cada um pra fazer o hole punching. Tudo efêmero: se alguém apagar,
    // o pior caso é a sala cair e ser recriada. Por isso a postura é mais frouxa que
    // a dos docs de apostas (que são a fonte de verdade e nunca podem ser apagados).
    match /pc_rooms/{roomId} {
      allow read: if true;
      allow create, update: if request.resource.data.name is string
        && request.resource.data.name.size() <= 40
        && request.resource.data.size() <= 8;
      allow delete: if true;   // sala vazia pode ser fechada pelo app

      // Presença + endereços pro hole punching. Cada peer só escreve o próprio doc
      // (o id é gerado por sessão), e o doc é pequeno e descartável.
      match /peers/{peerId} {
        allow read, delete: if true;
        allow create, update: if request.resource.data.size() <= 12
          && (!('nick' in request.resource.data)
              || (request.resource.data.nick is string && request.resource.data.nick.size() <= 30));
      }
    }

    // PRIMICORD — presença global (quem está com o app aberto e em que sala).
    // Um doc por nick, sobrescrito por heartbeat a cada ~20s. Puramente efêmero.
    match /pc_presence/{nick} {
      allow read, delete: if true;
      allow create, update: if request.resource.data.size() <= 6
        && request.resource.data.lastSeen is int;
    }

    // PRIMICORD — chat do canal geral.
    // ATENÇÃO: mensagens NÃO podem ser editadas nem apagadas por aqui (update/delete
    // negados) — sem Firebase Auth a rules não sabe quem está pedindo, então liberar
    // update deixaria qualquer um reescrever a fala dos outros.
    match /pc_chat/{channel}/msgs/{msgId} {
      allow read: if true;
      allow create: if isValidChatMsg(request.resource.data);
      allow update, delete: if false;
    }

    // PRIMICORD — mensagens diretas entre dois membros.
    // PRIVACIDADE: a leitura é PÚBLICA. Sem Firebase Auth não há como a rules provar
    // quem é o solicitante, então qualquer um com a apiKey consegue ler as conversas.
    // Serve pra combinar jogo, não pra segredo — o app avisa isso no topo da DM.
    // Fechar isso de verdade exige Firebase Auth (ver PRÓXIMO PASSO no topo).
    match /pc_dm/{pair}/msgs/{msgId} {
      allow read: if true;
      allow create: if isValidChatMsg(request.resource.data);
      allow update, delete: if false;
    }

    // Tudo mais é negado por padrão (defensivo contra futuras coleções).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// ───────── helpers ─────────

// Doc principal precisa ter `json` (string com o payload serializado).
// Campos top-level extras (interests, comments, teamPlayers, worldcup,
// updatedAt) são permitidos mas opcionais.
function isValidApostasDoc(data) {
  return data.keys().hasAll(['json'])
    && data.json is string
    && payloadFits(data);
}

// Limita payload total a ~1MB. O real fica em ~50KB, isso é só safety net
// contra atacante tentando estourar quota do Firestore.
function payloadFits(data) {
  return data.json is string
    && data.json.size() < 1048576;
}

// Mensagem de chat válida: autor, texto e horário, com tamanhos sãos.
// (usada pelo canal geral e pelas DMs do Primicord)
function isValidChatMsg(data) {
  return data.keys().hasAll(['nick', 'text', 'at'])
    && data.size() <= 5
    && data.nick is string && data.nick.size() > 0 && data.nick.size() <= 30
    && data.text is string && data.text.size() > 0 && data.text.size() <= 500
    && data.at is int;
}

// Não permite zerar dados quando antes tinha conteúdo. Os maps/arrays
// (users, bets, teamPlayers, rounds) ficam dentro da string JSON, então a
// checagem é só "payload novo é razoavelmente menor que o antigo? aborta".
// Heurística: novo não pode ser <40% do anterior. Em condições normais
// updates aumentam ou mantêm o tamanho; uma queda brusca = wipe.
// Usado pelos DOIS docs (apostas e state).
function notWipingJson(newData, oldData) {
  return !(oldData.json is string)
    || newData.json.size() >= (oldData.json.size() * 4 / 10);
}
