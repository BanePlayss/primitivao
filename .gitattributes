# Normalizacao de fim de linha.
# O projeto vive numa particao NTFS, entao sem isso ferramentas Windows
# convertem a arvore inteira pra CRLF e todo arquivo vira "modificado".
# Regra: no repositorio, SEMPRE LF.

* text=auto eol=lf

# Fontes
*.js    text eol=lf
*.jsx   text eol=lf
*.mjs   text eol=lf
*.cjs   text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.json  text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.rules text eol=lf
*.sh    text eol=lf

# Binarios: nunca tocar
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.svg  text eol=lf
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.mp3   binary
*.mp4   binary
*.pdf   binary
*.zip   binary
